{
  "filesystem": {
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspaces/yoke"]
  },
  "linear": {
    "transport": "http",
    "url": "https://mcp.linear.app/mcp",
    "headers": {
      "Authorization": "Bearer ${LINEAR_API_KEY}"
    }
  },
  "github": {
    "enabled": false
  },
  "docs": {
    "transport": "sse",
    "url": "https://example.com/sse"
  },
  "scratch": {
    "transport": "stdio",
    "command": "node",
    "args": ["server.js"],
    "enabled": false
  }
}

{
  "name": "yoke",
  "version": "0.1.0",
  "private": true,
  "description": "One config, any coding harness. Sync MCP servers, instructions, and sessions across AI coding CLIs.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "yoke": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox:build": "docker build -f docker/sandbox/Dockerfile -t yoke-sandbox .",
    "sandbox": "docker run --rm -it yoke-sandbox",
    "sandbox:ssh": "docker run -d --name yoke-sandbox-ssh --rm -p 127.0.0.1:2222:2222 --entrypoint /opt/yoke/docker/sandbox/ssh-entrypoint.sh yoke-sandbox",
    "sandbox:ssh:stop": "docker stop yoke-sandbox-ssh"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^20.19.43",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
